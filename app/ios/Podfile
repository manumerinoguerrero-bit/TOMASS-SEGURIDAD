# ============================================================================
# Tomass Seguridad — Complementos de la versión para iPhone
# ============================================================================
# QUÉ ES ESTE ARCHIVO
#
#   La lista de piezas de otras personas que la app necesita para funcionar en
#   iPhone. Es el equivalente de lo que en Android hace el archivo build.gradle.
#
# POR QUÉ DICE 15.5 Y NO UN NÚMERO MÁS BAJO
#
#   Porque es el mínimo que exigen dos piezas que la app usa de verdad:
#
#     · google_mlkit_text_recognition (lee la patente de la foto)  → iOS 15.5
#     · mobile_scanner (lee el código QR del muro)                 → iOS 15.5
#
#   El proyecto venía puesto en iOS 13, que era lo que Flutter deja por defecto.
#   Con ese número la app NO compila para iPhone: al instalar las piezas falla
#   diciendo que piden una versión más nueva que la declarada.
#
#   iOS 15.5 salió en mayo de 2022 y anda desde el iPhone 6s en adelante, así
#   que en la práctica cubre cualquier iPhone que alguien use hoy.
#
#   ⚠️ Este número tiene que ser IGUAL al que dice IPHONEOS_DEPLOYMENT_TARGET en
#      ios/Runner.xcodeproj/project.pbxproj. Si se cambia uno, hay que cambiar
#      el otro.
# ============================================================================

platform :ios, '15.5'

# Xcode arma la app de dos maneras: una para probar y otra para publicar.
# Esto le dice cuál es cuál.
project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(
    File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)

  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} no existe. Corré: flutter pub get"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end

  raise "No encontré FLUTTER_ROOT. Borrá Generated.xcconfig y corré: flutter pub get"
end

require File.expand_path(
  File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # Algunas piezas traen su propio número de versión mínima, más bajo que el
      # nuestro. Sin esta línea, Xcode tira cientos de advertencias por eso.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'
    end
  end
end
